# Cijeli broj, najmanje 1. Prva provjera nakon baselinea čeka ovaj interval.
CHECK_INTERVAL_MINUTES=5

# Putanja je relativna prema mapi projekta ako nije apsolutna.
DATABASE_PATH=data/seen.sqlite

# Pauza između stranica pretrage, u sekundama.
PAGE_DELAY_SECONDS=0.3

# Koliko oglasa poslati u jednom testnom mailu na prvom prolazu. 0 preskače test.
TEST_LISTING_COUNT=1

# Gmail: smtp.gmail.com, port 587, app password (ne lozinka računa).
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM=
MAIL_TO=
